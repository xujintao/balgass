# 云端开发 Supabase 项目（与生产项目分开）
SUPABASE_URL=https://your-development-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# 服务端专用，禁止使用 NEXT_PUBLIC_ 前缀
SUPABASE_SECRET_KEY=replace-with-secret-key
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 仅 localhost 开发允许关闭 CAPTCHA；云端 Auth 的 CAPTCHA 配置需与之匹配
AUTH_CAPTCHA_DISABLED=true
# 真实认证集成测试使用专用开发项目
TEST_SUPABASE_SECRET_KEY=
