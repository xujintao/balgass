# Copy to .env on the VPS and set GAME_API_TOKEN. For local runs, use absolute paths in your local .env.
TZ=UTC
DEBUG=false
GAME_API_TOKEN=
LOG_LEVEL=info
LOG_FILE=-
PATH_CONFIG=/etc/server-game
PATH_COMMON=/etc/server-game-common
TRACE_BOT_POLICY_ENABLE=false
TRACE_BOT_POLICY_FILE=/tmp/server-game-bot-policy.jsonl
