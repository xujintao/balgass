# Copy to .env and set GAME_API_TOKEN and DB_PASSWORD. For local runs, set PATH_COMMON to an absolute path.
TZ=UTC
DEBUG=false
LOG_LEVEL=info
LOG_FILE=-
PATH_COMMON=/etc/server-game-common
TRACE_BOT_POLICY_ENABLE=false
TRACE_BOT_POLICY_FILE=/tmp/server-game-bot-policy.jsonl
SERVER_CODE=0
NON_PVP=false
GAME_SERVER_PORT=56900
CONNECT_SERVER_IP=127.0.0.1
CONNECT_SERVER_PORT=55667
MAX_PLAYER_COUNT=50
MAX_MONSTER_COUNT=11500
MAX_SUMMON_MONSTER_COUNT=400
MAX_OBJECT_ITEM_COUNT=300
HTTP_PORT=8080
GAME_API_TOKEN=
DB_NAME=game
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
