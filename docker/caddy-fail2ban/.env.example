# Generate with: docker run --rm caddy:2-alpine caddy hash-password
# Store the resulting hash here. Keep the original password in Vercel as
# GAME_BASIC_AUTH_PASSWORD. It grants access to both game config and commands.
TZ=UTC
GAME_BASIC_AUTH_USER=replace_with_your_username
GAME_BASIC_AUTH_PASSWORD_HASH=replace_with_your_hash
